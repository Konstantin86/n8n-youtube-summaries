    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const out = {\n    success: false,\n    content: \"\",\n    error: \"\"\n  };\n\n  // success case: text is present\n  if (item.json.text) {\n    out.success = true;\n    out.content = item.json.text;\n  } \n  // error case: OpenAI or HTTP error\n  else if (item.json.error) {\n    out.error = item.json.error.message || String(item.json.error);\n  } \n  else {\n    out.error = \"Empty or unexpected response\";\n  }\n\n  return { json: out };\n});"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1328,
        656
      ],
      "name": "Map OpenAI response"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "52bd11a1-6458-4dd4-89be-395dbf7d7dfc",
              "leftValue": "={{ $json.success }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
