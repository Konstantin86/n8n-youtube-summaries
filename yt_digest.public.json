        "jsCode": "// If the HTTP node returns one item like: [{ json: { channels: [...] } }]\nconst first = $input.first().json;\nconst ids = Array.isArray(first.channels) ? first.channels : [];\n\n// Emit one item per channelId\nreturn ids.map(id => ({ json: { channelId: id } }));"
      },
