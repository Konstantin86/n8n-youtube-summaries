        "jsCode": "const it = $json.snippet || {};\nconst videoId = $json.id.videoId;\nconst channelTitle = $json.snippet.channelTitle;\nconst title = it.title || '(no title)';\nconst publishedAt = it.publishedAt || '';\nconst url = videoId ? `https://www.youtube.com/watch?v=${videoId}` : '';\nreturn { json: { videoId, channelTitle, title, url, publishedAt } };"
      },
