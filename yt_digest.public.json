        "jsCode": "// Replace the string below with the exact name of the node that produced {videoId,title,url,publishedAt}\nconst prev = $('Map Video Response').item.json;\n\n// When \"Continue On Fail\" is ON, HTTP node outputs { error: {...} } on non-2xx\nconst err = $json.error;\nconst text = $json.text; // present on 200 (plain=true)\n\nif (err || !text) {\n  // 404 or any other failure \u2192 mark and skip later\n  return {\n    ...prev,\n    noCaptions: true,\n    errorStatus: err?.status || null,\n    errorMessage: err?.message || null,\n  };\n}\n\nreturn {\n  ...prev,\n  transcript: text,         // plain text from your API\n  noCaptions: false,\n};"
      },
