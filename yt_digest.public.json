    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const chatId = 455634904; // or pass it in your item\n\nlet html = $json.content || \"\";\n\n// 1) strip code fences\nhtml = html.replace(/^```html\\s*/i, \"\").replace(/```$/i, \"\").trim();\n\n// 2) remove unsupported containers\nhtml = html.replace(/<\\/?(div|p)[^>]*>/gi, \"\");\n\n// 3) convert lists to bullets (we'll output \\n, not <br>)\nhtml = html\n  .replace(/<\\s*ul[^>]*>/gi, \"\")\n  .replace(/<\\s*ol[^>]*>/gi, \"\")\n  .replace(/<\\s*\\/\\s*(ul|ol)\\s*>/gi, \"\")\n  .replace(/<\\s*li[^>]*>/gi, \"\u2022 \")\n  .replace(/<\\s*\\/\\s*li\\s*>/gi, \"\\n\");\n\n// 4) normalize line breaks to \\n (no <br> anywhere)\nhtml = html.replace(/\\r?\\n+/g, \"\\n\").replace(/\\n{3,}/g, \"\\n\\n\");\n\n// 5) keep <a> but drop all attributes except href and strip formatting inside links\nhtml = html.replace(/<a\\s+[^>]*href=\"([^\"]+)\"[^>]*>([\\s\\S]*?)<\\/a>/gi, (m, href, inner) => {\n  const text = inner.replace(/<\\/?[^>]+>/g, \"\"); // no tags inside link text\n  return `<a href=\"${href}\">${text}</a>`;\n});\n\n// 6) remove any remaining tags except <a>, <b>, <i>, <u>, <s>, <code>, <pre>, <blockquote>\nhtml = html.replace(/<(?!\\/?(a|b|i|u|s|code|pre|blockquote)\\b)[^>]*>/gi, \"\");\n\n// 7) ensure a title link exists at top (WITHOUT <b> wrapper to avoid nesting issues)\nif (!/^<a\\s+href=/i.test(html) && $json.url && $json.title) {\n  const safeTitle = String($json.title).replace(/[<&]/g, c => (c === \"<\" ? \"&lt;\" : \"&amp;\"));\n  html = `<a href=\"${$json.url}\">${safeTitle}</a>\\n` + html;\n}\n\n// 8) collapse excessive blank lines\nhtml = html.replace(/\\n{3,}/g, \"\\n\\n\");\n\n// 9) Telegram limit (~4096). Keep a margin.\nconst MAX = 3800;\nif (html.length > MAX) html = html.slice(0, MAX - 1) + \"\u2026\";\n\nreturn {\n  json: {\n    success: true,\n    chatId,\n    text: html, // Use with Telegram \"Send a text message\" (Parse Mode = HTML)\n  }\n};"
      },
