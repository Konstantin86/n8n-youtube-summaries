      "parameters": {
        "jsCode": "// Collect channel IDs from all pages\nconst out = [];\nfor (const page of $input.all()) {\n  const items = page.json.items || [];\n  for (const it of items) {\n    const cid = it?.snippet?.resourceId?.channelId;\n    if (cid && it?.contentDetails.newItemCount > 0) out.push({ json: { channelId: cid } });\n  }\n}\nreturn out;"
