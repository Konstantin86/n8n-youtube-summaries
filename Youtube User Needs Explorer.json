        "jsCode": "return $input.all().map(item => {  \n\n  \n  const out = {\n    success: false,\n    content: \"\",\n    error: \"\"\n  };\n\n  // success case: text is present\n  if (item.json.text) {\n    out.success = true;\n    out.content = item.json.text;\n  } \n  // error case: OpenAI or HTTP error\n  else if (item.json.error) {\n    out.error = item.json.error.message || String(item.json.error);\n  } \n  else {\n    out.error = \"Empty or unexpected response\";\n  }\n\n  return { json: out };\n});"
