      "parameters": {
        "jsCode": "// Loop over input items and add a new field called 'myNewField' to the JSON of each one\nlet combinedText = \"\";\n\n// 'items' is the array of all items passed into this node\nfor (const item of $input.all()) {\n  // Get the comment text from the exact path\n  const text = item.json['snippet.topLevelComment.snippet.textDisplay'];\n  \n  // Add the text and a newline character\n  combinedText += text + \"\\n\";\n}\n\n// Return a new, single item.\n// The next node can access this as '{{ $json.allCommentText }}'\nreturn [\n  {\n    json: {\n      allCommentText: combinedText.trim() // .trim() removes any trailing newline\n    }\n  }\n];\n\n"
      },
